# Kopiraj u .env.local i popuni stvarnim vrijednostima:
#   cp .env.local.example .env.local
# .env.local je u .gitignore — NIKAD ne commituj prave ključeve.

# --- Supabase (Dashboard -> Project Settings -> API) ---
# Javni podaci (smiju u browser, prefiks NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=https://tvoj-projekat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Server-only (NIKAD prefiks NEXT_PUBLIC_) ---

# service_role ključ — zaobilazi RLS, koristi se samo na serveru
# (cron rute, kreiranje člana). Drži ga u tajnosti.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Resend API ključ za slanje emailova (podsjetnici, digest, pozivnice).
# https://resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Tajna kojom su zaštićene cron rute (/api/cron/*). Nasumičan string.
# Npr. generiši:  openssl rand -hex 24
CRON_SECRET=zamijeni-nasumicnim-stringom
